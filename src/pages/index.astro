---
import { getEntry } from 'astro:content';
import Hero from '../components/sections/Hero.astro';
import Products from '../components/sections/Products.astro';
import SiteIntro from '../components/SiteIntro.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SectionMotion from '../components/SectionMotion.astro';
import PurePassion from '../components/sections/PurePassion.astro';
import Video from '../components/sections/Video.astro';
import Heritage from '../components/sections/Heritage.astro';
import PartnershipsNews from '../components/sections/PartnershipsNews.astro';
import ExclusiveUpdates from '../components/sections/ExclusiveUpdates.astro';
import Footer from '../components/sections/Footer.astro';
import '../styles/global.css';

const site = await getEntry('site', 'main');
if (!site) throw new Error('Missing site metadata content');
const { language, title, description, social } = site.data;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---

<html lang={language} prefix="og: https://ogp.me/ns#">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="theme-color" content="#16100b" />
		<script is:inline>
			// Opt in before first paint; without JS the page remains immediately usable.
			// The Home link uses #hero, which should still replay the opening on reload.
			const isHome = !location.hash || location.hash === '#hero';
			if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && isHome &&
				performance.getEntriesByType('navigation')[0]?.type !== 'back_forward') {
				document.documentElement.dataset.intro = 'showing';
				// Independent fallback if the main script or an asset fails to load.
				window.setTimeout(() => {
					delete document.documentElement.dataset.intro;
				}, 5500);
			}
		</script>
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={social.siteName} />
		<meta property="og:locale" content={social.locale} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
		<meta property="og:image" content={social.image.src} />
		<meta property="og:image:secure_url" content={social.image.src} />
		<meta property="og:image:type" content={social.image.type} />
		<meta property="og:image:width" content={String(social.image.width)} />
		<meta property="og:image:height" content={String(social.image.height)} />
		<meta property="og:image:alt" content={social.image.alt} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={social.image.src} />
		<meta name="twitter:image:alt" content={social.image.alt} />
		<link rel="preload" href="/fonts/abril-fatface-latin.woff2" as="font" type="font/woff2" crossorigin />
		<title>{title}</title>
	</head>
	<body>
		<SiteIntro />
		<div data-site-content>
			<SiteHeader />
			<main>
				<Hero />
				<Products />
				<PurePassion />
				<Video />
				<Heritage />
				<PartnershipsNews />
				<ExclusiveUpdates />
			</main>
			<Footer />
		</div>
		<SectionMotion />
	</body>
</html>
