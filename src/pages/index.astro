---
import { getEntry } from 'astro:content';
import Hero from '../components/sections/Hero.astro';
import Products from '../components/sections/Products.astro';
import SiteIntro from '../components/SiteIntro.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SectionMotion from '../components/SectionMotion.astro';
import PurePassion from '../components/sections/PurePassion.astro';
import Video from '../components/sections/Video.astro';
import Heritage from '../components/sections/Heritage.astro';
import PartnershipsNews from '../components/sections/PartnershipsNews.astro';
import ExclusiveUpdates from '../components/sections/ExclusiveUpdates.astro';
import Footer from '../components/sections/Footer.astro';
import SEOHead from '../components/SEOHead.astro';
import '../styles/global.css';

const site = await getEntry('site', 'main');
const footer = await getEntry('footer', 'main');
if (!site || !footer) throw new Error('Missing site metadata content');
const { language } = site.data;
const root = new URL('/', Astro.site ?? 'https://origentolima.com').href;
const [locality, region] = footer.data.location;
// Placeholder social links ("#") are not real profiles, so only absolute URLs are listed.
const sameAs = footer.data.socials.map((social) => social.href).filter((href) => /^https?:\/\//.test(href));
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Organization', '@id': `${root}#organization`,
			name: footer.data.brand, url: root,
			logo: new URL('/icon-512.png', root).href,
			description: site.data.description,
			email: footer.data.contact.email, telephone: footer.data.contact.phone.label,
			address: { '@type': 'PostalAddress', addressLocality: locality, addressRegion: region.split(',')[0].trim(), addressCountry: 'CO' },
			...(sameAs.length && { sameAs }),
		},
		{
			'@type': 'WebSite', '@id': `${root}#website`,
			name: site.data.social.siteName, url: root, inLanguage: language,
			publisher: { '@id': `${root}#organization` },
		},
	],
};
---

<html lang={language} prefix="og: https://ogp.me/ns#">
	<head>
		<SEOHead structuredData={structuredData} />
		<script is:inline>
			// Opt in before first paint; without JS the page remains immediately usable.
			// The Home link uses #hero, which should still replay the opening on reload.
			const isHome = !location.hash || location.hash === '#hero';
			if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && isHome &&
				performance.getEntriesByType('navigation')[0]?.type !== 'back_forward') {
				document.documentElement.dataset.intro = 'showing';
				// Independent fallback if the main script or an asset fails to load.
				window.setTimeout(() => {
					delete document.documentElement.dataset.intro;
				}, 5500);
			}
		</script>
	</head>
	<body>
		<SiteIntro />
		<div data-site-content>
			<SiteHeader />
			<main>
				<Hero />
				<Products />
				<PurePassion />
				<Video />
				<Heritage />
				<PartnershipsNews />
				<ExclusiveUpdates />
			</main>
			<Footer />
		</div>
		<SectionMotion />
		<script>
			// In-app browsers (e.g. opened from a QR scan) can resize the viewport right after
			// jumping to a #fragment. The svh-based hero then changes height and the target
			// slides under the header, so keep it aligned until the visitor starts scrolling.
			const id = decodeURIComponent(location.hash.slice(1));
			const target = id && id !== 'hero' ? document.getElementById(id) : null;
			if (target) {
				const realign = () => target.scrollIntoView({ block: 'start', behavior: 'instant' });
				const interactions = ['pointerdown', 'touchstart', 'wheel', 'keydown'];
				const stop = () => {
					window.removeEventListener('resize', realign);
					window.visualViewport?.removeEventListener('resize', realign);
					window.removeEventListener('load', realign);
					for (const type of interactions) window.removeEventListener(type, stop, true);
				};
				window.addEventListener('resize', realign);
				window.visualViewport?.addEventListener('resize', realign);
				window.addEventListener('load', realign);
				for (const type of interactions) window.addEventListener(type, stop, { capture: true, passive: true });
				window.setTimeout(stop, 5000);
			}
		</script>
	</body>
</html>
