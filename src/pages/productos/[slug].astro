---
import { getEntry } from 'astro:content';
import { getProducts, type Product } from '../../lib/products';
import SEOHead from '../../components/SEOHead.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Footer from '../../components/sections/Footer.astro';
import PackagingPattern from '../../components/PackagingPattern.astro';
import '../../styles/global.css';

export async function getStaticPaths() {
	const products = await getProducts();
	return products.map((product) => ({
		params: { slug: product.slug },
		props: { product, related: products.filter((other) => other.slug !== product.slug) },
	}));
}

interface Props { product: Product; related: Product[] }
const { product, related } = Astro.props;
const footer = await getEntry('footer', 'main');
const site = await getEntry('site', 'main');
if (!footer || !site) throw new Error('Missing product page brand content');
const orderUrl = new URL(footer.data.contact.phone.href);
orderUrl.searchParams.set('text', product.orderMessage);
const root = new URL('/', Astro.site ?? 'https://origentolima.com').href;
const canonical = new URL(product.href, root).href;
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Organization', '@id': `${root}#organization`,
			name: footer.data.brand, url: root,
			logo: new URL('/icon-512.png', root).href,
			email: footer.data.contact.email, telephone: footer.data.contact.phone.label,
		},
		{
			'@type': 'Product', '@id': `${canonical}#product`,
			name: product.name, description: product.intro, url: canonical,
			image: [product.image.src], category: 'Cacao para bebidas',
			brand: { '@id': `${root}#organization` },
			additionalProperty: [
				{ '@type': 'PropertyValue', name: 'Porcentaje de cacao', value: product.percentage },
				{ '@type': 'PropertyValue', name: 'Endulzante', value: product.sweetener },
				{ '@type': 'PropertyValue', name: 'Origen', value: 'San Sebastián de Mariquita, Tolima, Colombia' },
			],
		},
		{
			'@type': 'BreadcrumbList', '@id': `${canonical}#breadcrumb`,
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: 'Inicio', item: root },
				{ '@type': 'ListItem', position: 2, name: 'Nuestros cacaos', item: `${root}#products` },
				{ '@type': 'ListItem', position: 3, name: product.name, item: canonical },
			],
		},
	],
};
---

<html lang={site.data.language} prefix="og: https://ogp.me/ns#">
	<head>
		<SEOHead title={product.title} description={product.metaDescription} image={product.image} structuredData={structuredData} />
	</head>
	<body class="product-page">
		<a class="skip-link" href="#product-main">Saltar al contenido</a>
		<SiteHeader />
		<main id="product-main">
			<section class="product-hero" aria-labelledby="product-title">
				<div class="page-container">
					<nav class="breadcrumbs" aria-label="Ruta de navegación">
						<ol>
							<li><a href="/">Inicio</a></li>
							<li><a href="/#products">Nuestros cacaos</a></li>
							<li aria-current="page">{product.name}</li>
						</ol>
					</nav>
					<div class="product-hero__grid">
						<div class="product-gallery">
							<div class="product-gallery__frame">
								<img src={product.image.src} alt={product.image.alt} width={product.image.width} height={product.image.height} fetchpriority="high" loading="eager" decoding="async" />
								<span class="product-gallery__label">Cacao de autor <span aria-hidden="true">/</span> {String(product.order).padStart(2, '0')}</span>
							</div>
							<div class="product-gallery__caption"><span>Un origen. Un ritual propio.</span><span>Tolima, Colombia</span></div>
						</div>
						<div class="product-summary">
							<p class="eyebrow">{product.eyebrow}</p>
							<h1 id="product-title"><span>{product.percentage} cacao</span>{' '}<span class="product-title__variety">{product.variety}</span></h1>
							<p class="product-summary__intro">{product.intro}</p>
							<dl class="product-facts">
								<div><dt>Cacao</dt><dd>{product.percentage}</dd></div>
								<div><dt>Endulzante</dt><dd>{product.sweetener}</dd></div>
								<div><dt>Origen</dt><dd>Mariquita, Tolima</dd></div>
							</dl>
							<a class="button button--primary" href={orderUrl.href} aria-label={`Consultar y pedir ${product.name} por WhatsApp`}>
								<span>Consultar y pedir</span><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.25" /></svg>
							</a>
							<p class="product-summary__order-note">Presentaciones, precios y envíos por WhatsApp.</p>
							<a class="text-link" href="#preparacion">Cómo disfrutarlo <span aria-hidden="true">↓</span></a>
						</div>
					</div>
				</div>
				<PackagingPattern class="product-pattern" />
			</section>

			<section class="product-story cream-section" aria-labelledby="story-title">
				<div class="page-container">
					<div class="editorial-heading">
						<div><p class="eyebrow">El carácter de nuestro cacao</p><h2 id="story-title">{product.story.heading}</h2></div>
						<p class="editorial-copy">{product.story.description}</p>
					</div>
					<div class="tasting-notes">
						{product.notes.map((note, index) => <article class="tasting-note">
							<span class="note-number" aria-hidden="true">0{index + 1}</span>
							<h3>{note.heading}</h3><p>{note.description}</p>
						</article>)}
					</div>
				</div>
			</section>

			<section id="preparacion" class="preparation" aria-labelledby="preparation-title">
				<div class="page-container preparation__grid">
					<div class="preparation__intro">
						<p class="eyebrow">El arte de hacer una pausa</p>
						<h2 id="preparation-title">Una taza.<br /><em>Tu momento.</em></h2>
						<p>Cómo disfrutar el {product.name.toLowerCase()} en una bebida hecha a tu manera.</p>
						<a class="text-link" href={orderUrl.href}>Conversemos sobre tu cacao <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.25" /></svg></a>
					</div>
					<ol class="preparation-steps">
						{product.preparation.map((step, index) => <li>
							<span class="step-number" aria-hidden="true">0{index + 1}</span>
							<div><h3>{step.heading}</h3><p>{step.description}</p></div>
						</li>)}
					</ol>
				</div>
			</section>

			<section class="product-faq cream-section" aria-labelledby="faq-title">
				<div class="page-container faq-grid">
					<div><p class="eyebrow">Antes de tu primera taza</p><h2 id="faq-title">Conoce un poco más.</h2><p class="faq-intro">Todo comienza con una buena conversación. Aquí respondemos algunas preguntas sobre tu cacao.</p></div>
					<div class="faq-list">
						{product.faqs.map((faq) => <details>
							<summary>{faq.question}<span class="faq-toggle" aria-hidden="true"></span></summary>
							<p>{faq.answer}</p>
						</details>)}
					</div>
				</div>
			</section>

			<section class="related cream-section" aria-labelledby="related-title">
				<div class="page-container">
					<div class="related__heading"><div><p class="eyebrow">Una pausa, distintas formas</p><h2 id="related-title">Encuentra tu cacao.</h2></div><a class="text-link" href="/#products">Ver nuestros cacaos <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.25" /></svg></a></div>
					<div class="related__grid">
						{related.map((other) => <article class="related-card">
							<a href={other.href} aria-label={`Descubrir ${other.name}`}>
								<div class="related-card__image"><img src={other.image.src} alt={other.image.alt} width={other.image.width} height={other.image.height} loading="lazy" decoding="async" /></div>
								<div class="related-card__copy"><div><p class="eyebrow">{other.variety === 'puro' ? 'Cacao puro' : other.variety}</p><h3>{other.name}</h3><p class="related-card__profile">{other.profile}</p></div><span class="related-card__arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.25" /></svg></span></div>
							</a>
						</article>)}
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.product-page { color: #f4f0e8; }
	.page-container { width: min(100% - 112px, 1280px); margin-inline: auto; }
	.eyebrow { font-size: 10px; font-weight: 500; line-height: 1.6; letter-spacing: 0.17em; text-transform: uppercase; color: #c6ab86; }
	h1, h2, h3 { font-family: 'Abril Fatface', Georgia, serif; font-weight: 400; letter-spacing: -0.025em; }
	h2 { font-size: clamp(34px, 3.5vw, 52px); line-height: 1.14; text-wrap: balance; }
	a { text-decoration: none; }
	a:focus-visible, summary:focus-visible { outline: 2px solid currentColor; outline-offset: 6px; }
	.skip-link { position: fixed; z-index: 100; left: 24px; top: 12px; padding: 14px 20px; background: #ead6ae; color: #16100b; transform: translateY(-200%); }
	.skip-link:focus { transform: none; }
	.product-hero { padding-top: calc(var(--site-header-height) + 36px); }
	.breadcrumbs { margin-bottom: 38px; color: #c1b7ab; font-size: 11px; line-height: 1.7; }
	.breadcrumbs ol { display: flex; flex-wrap: wrap; gap: 9px 0; padding: 0; list-style: none; }
	.breadcrumbs li + li::before { content: '/'; display: inline-block; margin-inline: 14px; color: #786956; }
	.breadcrumbs a { display: inline-block; padding-block: 6px; }
	.breadcrumbs a:hover { color: #ead6ae; }
	.breadcrumbs [aria-current] { padding-block: 6px; color: #ead6ae; }
	.product-hero__grid { display: grid; grid-template-columns: 1.08fr 1fr; align-items: center; gap: clamp(40px, 6vw, 88px); padding-bottom: 70px; }
	.product-gallery { min-width: 0; }
	.product-gallery__frame { position: relative; overflow: hidden; aspect-ratio: 1; background: #241b15; }
	.product-gallery__frame::after { content: ''; position: absolute; inset: 0; border: 1px solid rgb(234 214 174 / 12%); pointer-events: none; }
	.product-gallery__frame img { display: block; width: 100%; height: 100%; object-fit: cover; }
	.product-gallery__label { position: absolute; left: 22px; top: 22px; display: flex; gap: 16px; padding: 9px 12px; border: 1px solid rgb(234 214 174 / 35%); background: rgb(22 16 11 / 78%); color: #ead6ae; font-size: 9px; letter-spacing: 0.14em; text-transform: uppercase; }
	.product-gallery__label > span { color: #a68c6c; }
	.product-gallery__caption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 20px; margin-top: 16px; color: #b6a58f; font-size: 10px; line-height: 1.5; }
	.product-summary > .eyebrow { margin-bottom: 20px; }
	h1 { font-size: clamp(44px, 5vw, 74px); line-height: 1.04; color: #ead6ae; }
	h1 > span { display: block; }
	h1 .product-title__variety { margin-top: 10px; font-family: Georgia, serif; font-size: 0.71em; font-style: italic; font-weight: 400; letter-spacing: -0.045em; }
	.product-summary__intro { max-width: 45ch; margin-top: 27px; color: #c1b7ab; font-size: 15px; line-height: 1.85; }
	.product-facts { display: grid; grid-template-columns: 0.65fr 1.3fr 1fr; gap: 16px; margin-block: 30px; padding-block: 20px; border-block: 1px solid rgb(198 171 134 / 22%); }
	.product-facts dt { margin-bottom: 7px; color: #b6a58f; font-size: 9px; letter-spacing: 0.12em; text-transform: uppercase; }
	.product-facts dd { font-size: 12px; line-height: 1.6; }
	.button { display: flex; align-items: center; justify-content: space-between; gap: 20px; min-height: 54px; padding: 17px 24px; border: 1px solid #ead6ae; font-size: 11px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; transition: background-color 180ms ease, color 180ms ease; }
	.button svg { width: 20px; height: 20px; flex-shrink: 0; }
	.button--primary { background: #ead6ae; color: #16100b; }
	.button--primary:hover { background: #f4f0e8; }
	.product-summary__order-note { margin-top: 11px; text-align: center; font-size: 11px; line-height: 1.7; color: #b6a58f; }
	.product-summary > .text-link { margin-top: 22px; }
	.text-link { display: inline-flex; align-items: center; gap: 18px; min-height: 44px; padding-block: 8px; border-bottom: 1px solid currentColor; font-size: 11px; letter-spacing: 0.04em; color: inherit; }
	.text-link:hover { opacity: 0.75; }
	.text-link svg { width: 16px; height: 16px; flex-shrink: 0; }
	.product-pattern { height: 34px; border-top: 1px solid rgb(198 171 134 / 20%); color: rgb(198 171 134 / 42%); --pattern-size: 400px; }
	.cream-section { background: #f4f0e8; color: #241b15; }
	.cream-section .eyebrow { color: #785b37; }
	.product-story { padding-block: 100px 90px; }
	.editorial-heading { display: grid; grid-template-columns: 1fr 1fr; align-items: start; gap: 90px; }
	.editorial-heading h2 { max-width: 15ch; margin-top: 20px; }
	.editorial-copy { padding-top: 34px; color: #675b4e; font-size: 15px; line-height: 1.95; }
	.tasting-notes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; margin-top: 65px; }
	.tasting-note { padding-top: 20px; border-top: 1px solid #d4cbbf; }
	.note-number { color: #917757; font-size: 10px; letter-spacing: 0.08em; }
	.tasting-note h3 { margin-top: 18px; font-size: 24px; line-height: 1.25; }
	.tasting-note p { margin-top: 14px; color: #675b4e; font-size: 13px; line-height: 1.85; }
	.preparation { padding-block: 95px; background: radial-gradient(ellipse at 0% 100%, #2e2117, transparent 70%), #16100b; }
	.preparation__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 90px; }
	.preparation h2 { margin-top: 22px; font-size: clamp(42px, 4vw, 62px); color: #ead6ae; }
	.preparation h2 em { font-family: Georgia, serif; font-weight: 400; }
	.preparation__intro > p:not(.eyebrow) { max-width: 31ch; margin-top: 24px; font-size: 14px; line-height: 1.85; color: #c1b7ab; }
	.preparation__intro .text-link { margin-top: 22px; color: #ead6ae; }
	.preparation-steps { padding: 0; list-style: none; }
	.preparation-steps li { display: grid; grid-template-columns: 34px 1fr; gap: 25px; padding-block: 25px; border-top: 1px solid rgb(198 171 134 / 25%); }
	.preparation-steps li:first-child { padding-top: 20px; }
	.step-number { padding-top: 7px; color: #c6ab86; font-size: 11px; letter-spacing: 0.08em; }
	.preparation-steps h3 { font-size: 25px; color: #ead6ae; }
	.preparation-steps p { margin-top: 12px; font-size: 13px; line-height: 1.85; color: #c1b7ab; }
	.product-faq { padding-block: 95px; }
	.faq-grid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: 95px; }
	.faq-grid h2 { margin-top: 20px; max-width: 12ch; }
	.faq-intro { max-width: 32ch; margin-top: 24px; color: #675b4e; font-size: 14px; line-height: 1.85; }
	.faq-list details { border-top: 1px solid #d4cbbf; }
	.faq-list details:last-child { border-bottom: 1px solid #d4cbbf; }
	.faq-list summary { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding-block: 23px; font-size: 14px; line-height: 1.6; cursor: pointer; list-style: none; }
	.faq-list summary::-webkit-details-marker { display: none; }
	.faq-toggle { position: relative; width: 13px; height: 13px; flex-shrink: 0; }
	.faq-toggle::before, .faq-toggle::after { content: ''; position: absolute; inset: 6px 0 auto; height: 1px; background: currentColor; }
	.faq-toggle::after { transform: rotate(90deg); transition: transform 180ms ease; }
	details[open] .faq-toggle::after { transform: rotate(0deg); }
	.faq-list details > p { max-width: 54ch; padding-bottom: 23px; padding-right: 25px; color: #675b4e; font-size: 13px; line-height: 1.85; }
	.related { padding-block: 0 95px; }
	.related__heading { display: flex; align-items: end; justify-content: space-between; gap: 30px; padding-top: 60px; border-top: 1px solid #d4cbbf; }
	.related__heading h2 { margin-top: 18px; }
	.related__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 36px; margin-top: 38px; }
	.related-card__image { aspect-ratio: 3 / 2; overflow: hidden; background: #e3dcd2; }
	.related-card__image img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 500ms ease; }
	.related-card a:hover img { transform: scale(1.035); }
	.related-card a { display: block; color: inherit; }
	.related-card__copy { display: flex; justify-content: space-between; gap: 24px; padding-top: 24px; }
	.related-card h3 { margin-top: 6px; font-size: clamp(24px, 2.2vw, 32px); line-height: 1.2; }
	.related-card__profile { margin-top: 10px; font-size: 12px; color: #675b4e; }
	.related-card__arrow { display: grid; place-items: center; width: 40px; height: 40px; flex-shrink: 0; border: 1px solid #baad9b; border-radius: 50%; font-size: 20px; }
	.related-card__arrow svg { width: 17px; height: 17px; }
	@media (max-width: 1000px) {
		.page-container { width: calc(100% - 64px); }
		.product-hero__grid { gap: 36px; }
		h1 { font-size: clamp(40px, 5.6vw, 60px); }
		.editorial-heading, .preparation__grid, .faq-grid { gap: 48px; }
		.product-facts { grid-template-columns: 0.6fr 1.1fr; }
		.product-facts > div:last-child { grid-column: 1 / -1; }
	}
	@media (max-width: 700px) {
		.page-container { width: calc(100% - 48px); }
		.product-hero { padding-top: calc(var(--site-header-height) + 18px); }
		.breadcrumbs { margin-bottom: 22px; font-size: 10px; }
		.breadcrumbs li + li::before { margin-inline: 9px; }
		.product-hero__grid { grid-template-columns: 1fr; gap: 34px; padding-bottom: 44px; }
		.product-gallery__label { left: 14px; top: 14px; padding: 8px 10px; }
		.product-gallery__caption { font-size: 9px; }
		.product-summary > .eyebrow { margin-bottom: 18px; }
		h1 { font-size: clamp(44px, 12vw, 68px); }
		h1 .product-title__variety { margin-top: 6px; }
		.product-summary__intro { margin-top: 22px; font-size: 14px; }
		.product-facts { grid-template-columns: 0.6fr 1.3fr 1fr; gap: 13px; margin-block: 24px; }
		.product-facts > div:last-child { grid-column: auto; }
		.product-facts dd { font-size: 11px; }
		.product-pattern { height: 26px; --pattern-size: 280px; }
		.product-story { padding-block: 58px; }
		.editorial-heading, .preparation__grid, .faq-grid { grid-template-columns: 1fr; gap: 26px; }
		.editorial-heading h2 { max-width: 17ch; margin-top: 16px; }
		.editorial-copy { padding-top: 0; font-size: 14px; line-height: 1.85; }
		.tasting-notes { grid-template-columns: 1fr; gap: 27px; margin-top: 34px; }
		.tasting-note { display: grid; grid-template-columns: 26px 1fr; gap: 0 12px; padding-top: 22px; }
		.note-number { padding-top: 6px; }
		.tasting-note h3 { margin-top: 0; font-size: 23px; }
		.tasting-note p { grid-column: 2; margin-top: 10px; }
		.preparation { padding-block: 58px; }
		.preparation h2 { font-size: 47px; }
		.preparation__grid { gap: 37px; }
		.preparation-steps li { gap: 12px; grid-template-columns: 26px 1fr; }
		.preparation-steps h3 { font-size: 23px; }
		.product-faq { padding-block: 58px; }
		.faq-grid h2 { max-width: none; }
		.faq-intro { max-width: none; margin-top: 18px; }
		.faq-list summary { font-size: 13px; padding-block: 20px; }
		.related { padding-bottom: 58px; }
		.related__heading { align-items: start; flex-direction: column; gap: 18px; padding-top: 36px; }
		.related__heading h2 { margin-top: 15px; }
		.related__grid { grid-template-columns: 1fr; gap: 35px; margin-top: 28px; }
		.related-card__copy { padding-top: 18px; }
		.related-card h3 { font-size: 28px; }
	}
	@media (prefers-reduced-motion: reduce) {
		.button, .faq-toggle::after, .related-card__image img { transition: none; }
		.related-card a:hover img { transform: none; }
	}
</style>
