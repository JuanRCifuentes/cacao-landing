---
import { getEntry } from 'astro:content';
import SEOHead from '../components/SEOHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Footer from '../components/sections/Footer.astro';
import PackagingPattern from '../components/PackagingPattern.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	eyebrow: string;
	heading?: string;
	intro?: string;
	ogType?: 'website' | 'article';
	publishedTime?: string;
	modifiedTime?: string;
	section?: string;
	image?: { src: string; alt: string; width: number; height: number; type?: string };
	breadcrumbs?: { label: string; href?: string }[];
	structuredData?: Record<string, unknown>;
}

const { title, description, intro = description, ogType, publishedTime, modifiedTime, section, eyebrow, heading = title.split(' — ')[0], image, breadcrumbs = [], structuredData } = Astro.props;
const site = await getEntry('site', 'main');
if (!site) throw new Error('Missing editorial page site content');
---

<html lang={site.data.language} prefix="og: https://ogp.me/ns#">
	<head><SEOHead title={title} description={description} image={image} structuredData={structuredData} ogType={ogType} publishedTime={publishedTime} modifiedTime={modifiedTime} section={section} /></head>
	<body class="editorial-page">
		<a class="skip-link" href="#page-main">Saltar al contenido</a>
		<SiteHeader />
		<main id="page-main">
			<header class="editorial-hero">
				<div class="editorial-container">
					<nav class="breadcrumbs" aria-label="Ruta de navegación">
						<ol><li><a href="/">Inicio</a></li>{breadcrumbs.map((crumb) => <li><a href={crumb.href}>{crumb.label}</a></li>)}<li aria-current="page">{heading}</li></ol>
					</nav>
					<div class:list={['editorial-hero__grid', image && 'editorial-hero__grid--image']}>
						<div class="editorial-hero__copy"><p class="editorial-eyebrow">{eyebrow}</p><h1>{heading}</h1><p class="editorial-hero__intro">{intro}</p><slot name="hero-meta" /></div>
						{image && <div class="editorial-hero__image"><img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="eager" fetchpriority="high" decoding="async" /></div>}
					</div>
				</div>
				<PackagingPattern class="editorial-pattern" />
			</header>
			<div class="editorial-content"><div class="editorial-container"><slot /></div></div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.editorial-page { color: #f4f0e8; }
	.editorial-container { width: min(100% - 112px, 1280px); margin-inline: auto; }
	.skip-link { position: fixed; z-index: 100; left: 24px; top: 12px; padding: 14px 20px; background: #ead6ae; color: #16100b; transform: translateY(-200%); }
	.skip-link:focus { transform: none; }
	.editorial-page :global(a:focus-visible) { outline: 2px solid currentColor; outline-offset: 6px; }
	.editorial-hero { padding-top: calc(var(--site-header-height) + 36px); background: radial-gradient(ellipse at 0% 100%, #2e2117, transparent 70%), #16100b; }
	.breadcrumbs { margin-bottom: 42px; color: #c1b7ab; font-size: 11px; line-height: 1.7; }
	.breadcrumbs ol { display: flex; flex-wrap: wrap; gap: 8px 0; padding: 0; list-style: none; }
	.breadcrumbs li + li::before { content: '/'; display: inline-block; margin-inline: 14px; color: #786956; }
	.breadcrumbs a { display: inline-block; padding-block: 6px; text-decoration: none; }
	.breadcrumbs a:hover { color: #ead6ae; }
	.breadcrumbs [aria-current] { padding-block: 6px; color: #ead6ae; }
	.editorial-hero__grid { padding-bottom: 78px; }
	.editorial-hero__grid--image { display: grid; grid-template-columns: 1.1fr 1fr; align-items: center; gap: clamp(36px, 6vw, 80px); }
	.editorial-eyebrow { color: #c6ab86; font-size: 10px; font-weight: 500; line-height: 1.7; letter-spacing: .17em; text-transform: uppercase; }
	h1 { max-width: 18ch; margin-top: 21px; font-family: 'Abril Fatface', Georgia, serif; font-weight: 400; font-size: clamp(44px, 5.3vw, 76px); line-height: 1.08; letter-spacing: -.025em; text-wrap: balance; color: #ead6ae; }
	.editorial-hero__intro { max-width: 58ch; margin-top: 28px; color: #c1b7ab; font-size: 15px; line-height: 1.9; }
	.editorial-hero__image { overflow: hidden; aspect-ratio: 4 / 3; background: #241b15; border: 1px solid rgb(234 214 174 / 12%); }
	.editorial-hero__image img { display: block; width: 100%; height: 100%; object-fit: cover; }
	.editorial-pattern { height: 34px; border-top: 1px solid rgb(198 171 134 / 20%); color: rgb(198 171 134 / 42%); --pattern-size: 400px; }
	.editorial-content { padding-block: 85px 95px; background: #f4f0e8; color: #241b15; }
	.editorial-content :global(.editorial-prose), .editorial-content :global(.policy-content) { max-width: 72ch; margin-inline: auto; }
	.editorial-content :global(h2), .editorial-content :global(h3) { font-family: 'Abril Fatface', Georgia, serif; font-weight: 400; letter-spacing: -.025em; text-wrap: balance; }
	.editorial-content :global(h2) { margin-block: 40px 20px; font-size: clamp(28px, 3vw, 42px); line-height: 1.2; }
	.editorial-content :global(h3) { margin-block: 25px 14px; font-size: 25px; line-height: 1.25; }
	.editorial-content :global(p), .editorial-content :global(li) { color: #675b4e; font-size: 15px; line-height: 1.9; overflow-wrap: anywhere; }
	.editorial-content :global(p + p) { margin-top: 20px; }
	.editorial-content :global(ul), .editorial-content :global(ol) { margin-block: 20px; padding-left: 22px; }
	.editorial-content :global(.policy-content ul) { list-style: disc; }
	.editorial-content :global(.policy-content ol) { list-style: decimal; }
	.editorial-content :global(li + li) { margin-top: 10px; }
	.editorial-content :global(a) { color: #60472c; text-underline-offset: 5px; text-decoration: underline; }
	.editorial-content :global(a:hover) { color: #241b15; }
	.editorial-content :global(.editorial-prose > section:first-child h2), .editorial-content :global(.policy-content > section:first-child h2) { margin-top: 0; }
	@media (max-width: 1000px) { .editorial-container { width: calc(100% - 64px); } .editorial-hero__grid--image { gap: 36px; } }
	@media (max-width: 700px) {
		.editorial-container { width: calc(100% - 48px); }
		.editorial-hero { padding-top: calc(var(--site-header-height) + 18px); }
		.breadcrumbs { margin-bottom: 24px; font-size: 10px; }
		.breadcrumbs li + li::before { margin-inline: 9px; }
		.editorial-hero__grid { padding-bottom: 44px; }
		.editorial-hero__grid--image { grid-template-columns: 1fr; gap: 30px; }
		h1 { font-size: clamp(40px, 11vw, 62px); }
		.editorial-hero__intro { margin-top: 22px; font-size: 14px; }
		.editorial-pattern { height: 26px; --pattern-size: 280px; }
		.editorial-content { padding-block: 50px 58px; }
		.editorial-content :global(p), .editorial-content :global(li) { font-size: 14px; }
	}
</style>
