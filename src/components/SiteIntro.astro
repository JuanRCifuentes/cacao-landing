---
import { getEntry } from 'astro:content';
import CocoaLogo from './CocoaLogo.astro';

const footer = await getEntry('footer', 'main');
if (!footer) throw new Error('Missing brand content');
const { brand } = footer.data;
---

<div class="site-intro" data-site-intro aria-hidden="true">
	<div class="site-intro__signature" data-intro-signature>
		<CocoaLogo animated revealOnLoad brand={brand} showTagline={false} class="w-full" />
	</div>
</div>

<style>
	.site-intro {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: none;
		place-items: center;
		height: 100dvh;
		padding: 24px;
		color: #f4f0e8;
	}

	.site-intro::before {
		content: '';
		position: absolute;
		inset: 0;
		background: #16100b;
		opacity: 0;
	}

	.site-intro__signature {
		position: relative;
		width: min(74vw, 360px);
	}

	.site-intro__signature :global(.cocoa-logo__mark),
	.site-intro__signature :global(.cocoa-logo__wordmark) {
		transform-box: border-box;
		transform-origin: top left;
	}

	:global(html[data-intro]) { overflow: hidden; }
	:global(html[data-intro]) .site-intro { display: grid; }
	:global(html[data-intro='showing']) .site-intro::before {
		opacity: 1;
	}
	:global(html[data-intro='showing'] [data-site-content]) { visibility: hidden; }
	:global(html[data-intro] [data-hero-brand]),
	:global(html[data-intro] [data-hero-wordmark]) { visibility: hidden; }

	/* Let the name settle into the hero before the supporting copy appears. */
	:global(html[data-intro='showing'] #hero),
	:global(html[data-intro='showing'] #hero *),
	:global(html[data-intro] #hero .hero__content *) { animation-play-state: paused !important; }

	:global(html[data-intro='leaving']) .site-intro {
		pointer-events: none;
	}

	:global(html[data-intro='leaving']) .site-intro::before {
		transition: opacity 900ms cubic-bezier(0.4, 0, 0.2, 1);
	}

	:global(html[data-intro='leaving']) .site-intro__signature :global(.cocoa-logo__mark),
	:global(html[data-intro='leaving']) .site-intro__signature :global(.cocoa-logo__wordmark) {
		transform: translate3d(var(--intro-x, 0px), var(--intro-y, 0px), 0) scale(var(--intro-scale, 1));
		transition: transform 1100ms cubic-bezier(0.76, 0, 0.24, 1);
	}

	@media (prefers-reduced-motion: reduce) {
		:global(html[data-intro]) { overflow: visible; }
		:global(html[data-intro]) .site-intro { display: none; }
		:global(html[data-intro] [data-site-content]) { visibility: visible; }
		:global(html[data-intro] [data-hero-brand]),
		:global(html[data-intro] [data-hero-wordmark]) { visibility: visible; }
	}
</style>

<script>
	const root = document.documentElement;
	const intro = document.querySelector<HTMLElement>('[data-site-intro]');
	const mark = intro?.querySelector<SVGSVGElement>('.cocoa-logo__mark');
	const wordmark = intro?.querySelector<HTMLElement>('.cocoa-logo__wordmark');
	const headerMark = document.querySelector<SVGSVGElement>('[data-hero-brand] .cocoa-logo__mark');
	const heroWordmark = document.querySelector<HTMLElement>('[data-hero-wordmark]');

	if (intro && mark && wordmark && headerMark && heroWordmark && root.dataset.intro === 'showing') {
		const parts = [
			{ element: mark, destination: headerMark },
			{ element: wordmark, destination: heroWordmark },
		];
		const arrived = new Set<EventTarget>();
		const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
		let exitTimer: ReturnType<typeof setTimeout>;
		const delay = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms));

		const finish = () => {
			clearTimeout(exitTimer);
			delete root.dataset.intro;
			window.removeEventListener('keydown', skipOnKey, true);
			window.removeEventListener('hashchange', finish);
			window.removeEventListener('pagehide', finish);
			window.removeEventListener('resize', finishOnResize);
			motionPreference.removeEventListener('change', finish);
			for (const { element } of parts) element.removeEventListener('transitionend', finishOnArrival);
		};

		const skipOnKey = (event: KeyboardEvent) => {
			if (event.key === 'Escape' || event.key === 'Tab') finish();
		};

		const finishOnResize = () => {
			if (root.dataset.intro === 'leaving') finish();
		};

		const finishOnArrival = (event: TransitionEvent) => {
			if (event.target === event.currentTarget && event.propertyName === 'transform') {
				arrived.add(event.target);
				if (arrived.size === parts.length) finish();
			}
		};

		window.addEventListener('keydown', skipOnKey, true);
		window.addEventListener('hashchange', finish);
		window.addEventListener('pagehide', finish);
		window.addEventListener('resize', finishOnResize);
		motionPreference.addEventListener('change', finish);
		for (const { element } of parts) element.addEventListener('transitionend', finishOnArrival);

		const image = document.querySelector<HTMLImageElement>('#hero img');
		const imageReady = image?.decode().catch(() => {}) ?? Promise.resolve();
		const fontReady = document.fonts.ready.catch(() => {});

		// Allow the full logo reveal, but never wait indefinitely for an asset.
		Promise.race([
			Promise.all([delay(2500), imageReady, fontReady]),
			delay(3500),
		]).then(() => {
			if (root.dataset.intro !== 'showing') return;

			// The pod goes to the navigation; the live lettering becomes the hero title.
			// Measure each part separately so both settle exactly at every viewport size.
			for (const { element, destination } of parts) {
				const from = element.getBoundingClientRect();
				const to = destination.getBoundingClientRect();
				if (!from.width || !to.width) {
					finish();
					return;
				}
				element.style.setProperty('--intro-x', `${to.left - from.left}px`);
				element.style.setProperty('--intro-y', `${to.top - from.top}px`);
				element.style.setProperty('--intro-scale', `${to.width / from.width}`);
			}
			root.dataset.intro = 'leaving';
			exitTimer = setTimeout(finish, 1250);
		});
	}
</script>
