---
import { getEntry } from 'astro:content';
import { getLandingSection } from '../lib/content';
import CocoaLogo from './CocoaLogo.astro';
import HeroMenu from './HeroMenu.astro';
import PackagingPattern from './PackagingPattern.astro';

const { contactLabel, navigation } = await getLandingSection('hero', 'hero');
const footer = await getEntry('footer', 'main');
const site = await getEntry('site', 'main');
if (!footer || !site) {
	throw new Error('Missing navigation or brand content');
}

const { brand, tagline, contact } = footer.data;
---

<header class="site-header" data-site-header data-scrolled>
	<div class="site-header__inner">
		<HeroMenu navigation={navigation} brand={brand} tagline={tagline} contactEmail={contact.email} labels={site.data.menu} />
		<a class="site-header__brand" data-hero-brand href="#hero" aria-label={`${brand}, ${site.data.menu.homeLabel}`}>
			<CocoaLogo showWordmark={false} class="w-full" />
		</a>
		<a class="site-header__contact" href="#newsletter">
			<span>{contactLabel}</span>
			<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.25" />
			</svg>
		</a>
	</div>
	<div class="site-header__trim pointer-events-none" aria-hidden="true">
		<PackagingPattern class="h-full w-full text-[#c6ab86]/35 [--pattern-size:192px] md:[--pattern-size:240px]" />
	</div>
</header>

<style>
	.site-header {
		--header-padding-y: 24px;
		--header-trim-height: 12px;
		position: fixed;
		z-index: 50;
		inset: 0 0 auto;
		color: #f4f0e8;
	}

	.site-header::before {
		content: '';
		position: absolute;
		z-index: -1;
		inset: 0;
		pointer-events: none;
		/* Keep the Safari edge brown while the page remains visible through the bar. */
		background: linear-gradient(#16100b, rgb(22 16 11 / 72%) 32px);
		border-bottom: 1px solid rgb(234 214 174 / 24%);
		-webkit-backdrop-filter: blur(5px);
		backdrop-filter: blur(5px);
		opacity: 0;
		transition: opacity 180ms ease;
	}

	.site-header[data-scrolled]::before { opacity: 1; }
	.site-header__trim {
		height: var(--header-trim-height);
		opacity: 0;
		transition: opacity 240ms ease;
	}
	.site-header[data-scrolled] .site-header__trim { opacity: 1; }
	.site-header__inner {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		max-width: 1536px;
		margin-inline: auto;
		/* Center navigation in its own row and reserve space for the patterned edge. */
		padding: calc(var(--header-padding-y) - var(--header-trim-height) / 2) clamp(24px, 4vw, 64px);
	}

	.site-header__brand { display: grid; place-items: center; width: 44px; min-height: 44px; }
	.site-header__contact {
		display: inline-flex;
		align-items: center;
		justify-self: end;
		gap: 12px;
		min-height: 44px;
		font-size: 11px;
		line-height: 1.3;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.site-header__contact svg { width: 18px; height: 18px; }
	.site-header a:focus-visible { outline: 2px solid currentColor; outline-offset: 6px; }

	@media (max-width: 600px) {
		.site-header { --header-padding-y: 20px; }
		.site-header__inner { padding-inline: 24px; }
		.site-header__contact { justify-content: center; width: 44px; }
		.site-header__contact span {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip-path: inset(50%);
			white-space: nowrap;
		}
	}

	@media (min-width: 768px) {
		.site-header { --header-trim-height: 14px; }
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header::before,
		.site-header__trim { transition: none; }
	}
</style>

<script>
	const header = document.querySelector<HTMLElement>('[data-site-header]');
	if (header) {
		let scrolled = header.hasAttribute('data-scrolled');
		let height = 0;
		const updateScroll = () => {
			const next = window.scrollY > 0;
			if (next === scrolled) return;
			scrolled = next;
			header.toggleAttribute('data-scrolled', next);
		};
		const updateHeight = (next: number) => {
			if (next === height) return;
			height = next;
			document.documentElement.style.setProperty('--site-header-height', `${height}px`);
		};

		updateScroll();
		updateHeight(header.getBoundingClientRect().height);
		window.addEventListener('scroll', updateScroll, { passive: true });
		window.addEventListener('pageshow', updateScroll);
		if (typeof ResizeObserver !== 'undefined') {
			const observer = new ResizeObserver(([entry]) => {
				// Use the size already measured by the browser instead of forcing layout.
				updateHeight(entry.borderBoxSize?.[0]?.blockSize ?? header.getBoundingClientRect().height);
			});
			observer.observe(header);
		} else {
			window.addEventListener('resize', () => updateHeight(header.getBoundingClientRect().height));
		}
	}
</script>
