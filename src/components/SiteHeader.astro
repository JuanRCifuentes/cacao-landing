---
import { getEntry } from 'astro:content';
import CocoaLogo from './CocoaLogo.astro';
import HeroMenu from './HeroMenu.astro';

const section = await getEntry('landingSections', 'hero');
const footer = await getEntry('footer', 'main');
if (!section || section.data.type !== 'hero' || !footer) {
	throw new Error('Missing navigation or brand content');
}

const { contactLabel, navigation } = section.data;
const { brand, tagline, contact } = footer.data;
---

<header class="site-header" data-site-header data-scrolled>
	<div class="site-header__inner">
		<HeroMenu navigation={navigation} brand={brand} tagline={tagline} contactEmail={contact.email} />
		<a class="site-header__brand" data-hero-brand href="#hero" aria-label={`${brand}, home`}>
			<CocoaLogo showWordmark={false} class="w-full" />
		</a>
		<a class="site-header__contact" href="#newsletter">
			<span>{contactLabel}</span>
			<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.25" />
			</svg>
		</a>
	</div>
</header>

<style>
	.site-header {
		position: fixed;
		z-index: 50;
		inset: 0 0 auto;
		color: #f4f0e8;
	}

	.site-header::before {
		content: '';
		position: absolute;
		z-index: -1;
		inset: 0;
		pointer-events: none;
		/* Keep the Safari edge brown while the page remains visible through the bar. */
		background: linear-gradient(#16100b, rgb(22 16 11 / 72%) 32px);
		border-bottom: 1px solid rgb(234 214 174 / 24%);
		-webkit-backdrop-filter: blur(18px);
		backdrop-filter: blur(18px);
		opacity: 0;
		transition: opacity 180ms ease;
	}

	.site-header[data-scrolled]::before { opacity: 1; }
	.site-header__inner {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		max-width: 1536px;
		margin-inline: auto;
		padding: 24px clamp(24px, 4vw, 64px);
	}

	.site-header__brand { display: grid; place-items: center; width: 44px; min-height: 44px; }
	.site-header__contact {
		display: inline-flex;
		align-items: center;
		justify-self: end;
		gap: 12px;
		min-height: 44px;
		font-size: 11px;
		line-height: 1.3;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.site-header__contact svg { width: 18px; height: 18px; }
	.site-header a:focus-visible { outline: 2px solid currentColor; outline-offset: 6px; }

	@media (max-width: 600px) {
		.site-header__inner { padding: 20px 24px; }
		.site-header__contact { justify-content: center; width: 44px; }
		.site-header__contact span {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip-path: inset(50%);
			white-space: nowrap;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header::before { transition: none; }
	}
</style>

<script>
	const header = document.querySelector<HTMLElement>('[data-site-header]');
	if (header) {
		const updateScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 0);
		const updateHeight = () => {
			document.documentElement.style.setProperty('--site-header-height', `${header.getBoundingClientRect().height}px`);
		};

		updateScroll();
		updateHeight();
		window.addEventListener('scroll', updateScroll, { passive: true });
		window.addEventListener('pageshow', updateScroll);
		const observer = new ResizeObserver(updateHeight);
		observer.observe(header);
	}
</script>
