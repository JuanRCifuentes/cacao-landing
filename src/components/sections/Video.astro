---
import { getEntry } from 'astro:content';

const section = await getEntry('landingSections', 'video');

if (!section || section.data.type !== 'video') {
	throw new Error('Missing landing section content: video');
}

const { heading, description, video } = section.data;
---

<section id="video" aria-labelledby="video-heading" class="film">
	<header class="film__header" data-motion="rise">
		<h2 id="video-heading" class="film__heading">
			{heading.map((line) => <span class="block">{line}</span>)}
		</h2>
		<p class="film__description">{description}</p>
	</header>

	<div class="relative aspect-[4/3] w-full overflow-hidden md:aspect-video" data-video-player>
		<video
			class="h-full w-full object-cover"
			poster={video.poster}
			preload="metadata"
			playsinline
			data-video-element
		>
			<source src={video.src} type="video/mp4" />
		</video>
		<div class="pointer-events-none absolute inset-0 bg-black/15 transition-opacity duration-300" data-video-shade></div>
		<button
			type="button"
			aria-label={video.label}
			class="absolute top-1/2 left-1/2 flex h-16 w-24 -translate-x-1/2 -translate-y-1/2 cursor-pointer items-center justify-center rounded-[2px] bg-[#f4f0e8] text-[#16100b] transition-[background-color,opacity] duration-300 hover:bg-[#e7c681] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#f4f0e8] md:h-20 md:w-[120px]"
			data-video-button
		>
			<svg viewBox="0 0 13 17" class="h-[17px] w-[13px] fill-current" aria-hidden="true">
				<path d="M0 0L12.5 8.5L0 17V0Z"></path>
			</svg>
		</button>
	</div>
</section>

<style>
	.film {
		background: #16100b;
		color: #f4f0e8;
	}

	.film__header {
		max-width: 1200px;
		margin-inline: auto;
		padding: clamp(48px, 7vw, 104px) 24px clamp(40px, 5vw, 72px);
		text-align: center;
	}

	.film__heading {
		font-family: 'Abril Fatface', Georgia, serif;
		font-size: clamp(2rem, 6.2vw, 5.5rem);
		font-weight: 400;
		line-height: 1.13;
		letter-spacing: -0.025em;
	}

	.film__description {
		max-width: 36ch;
		margin: 24px auto 0;
		color: rgb(244 240 232 / 70%);
		font-size: 14px;
		line-height: 1.7;
	}
</style>

<script>
	document.querySelectorAll('[data-video-player]').forEach((player) => {
		const video = player.querySelector('[data-video-element]');
		const button = player.querySelector('[data-video-button]');
		const shade = player.querySelector('[data-video-shade]');

		if (!(video instanceof HTMLVideoElement) || !(button instanceof HTMLButtonElement)) return;

		const showButton = () => {
			button.classList.remove('pointer-events-none', 'opacity-0');
			shade?.classList.remove('opacity-0');
		};

		const hideButton = () => {
			button.classList.add('pointer-events-none', 'opacity-0');
			shade?.classList.add('opacity-0');
		};

		button.addEventListener('click', () => video.play());
		video.addEventListener('play', hideButton);
		video.addEventListener('pause', showButton);
		video.addEventListener('ended', showButton);
		video.addEventListener('click', () => (video.paused ? video.play() : video.pause()));
	});
</script>
