---
import { getLandingSection } from '../../lib/content';
import PackagingPattern from '../PackagingPattern.astro';

const { heading, description, video } = await getLandingSection('video', 'video');
---

<section id="video" aria-labelledby="video-heading" class="film">
	<header class="film__header" data-motion="rise">
		<PackagingPattern fade class="film__pattern" />
		<h2 id="video-heading" class="film__heading">
			{heading.map((line) => <span class="film__line">{line}</span>)}
		</h2>
		<p class="film__description">{description}</p>
	</header>

	<div class="film__player" data-video-player>
		<video
			class="film__video"
			poster={video.poster}
			preload="none"
			controls
			playsinline
			aria-label={video.label}
			data-video-element
		>
			<source src={video.src} type="video/mp4" />
		</video>
		<div class="film__shade" data-video-shade></div>
		<button
			type="button"
			aria-label={video.label}
			class="film__play"
			data-video-button
			hidden
		>
			<svg viewBox="0 0 13 17" class="film__icon" aria-hidden="true">
				<path d="M0 0L12.5 8.5L0 17V0Z"></path>
			</svg>
		</button>
	</div>
</section>

<style>
	.film {
		background: #16100b;
		color: #f4f0e8;
	}

	.film__header {
		max-width: 1200px;
		margin-inline: auto;
		padding: clamp(48px, 7vw, 104px) 24px clamp(40px, 5vw, 72px);
		text-align: center;
	}

	.film__heading {
		font-family: 'Abril Fatface', Georgia, serif;
		font-size: clamp(2rem, 6.2vw, 5.5rem);
		font-weight: 400;
		line-height: 1.13;
		letter-spacing: -0.025em;
	}

	.film__description {
		max-width: 36ch;
		margin: 24px auto 0;
		color: rgb(244 240 232 / 70%);
		font-size: 14px;
		line-height: 1.7;
	}

	.film__header :global(.film__pattern) {
		--pattern-size: 240px;
		width: 9rem;
		height: 1.5rem;
		margin: 0 auto 1.75rem;
		color: rgb(198 171 134 / 45%);
	}

	.film__line { display: block; }

	.film__player {
		position: relative;
		width: 100%;
		aspect-ratio: 4 / 3;
		overflow: hidden;
	}

	.film__video { width: 100%; height: 100%; object-fit: cover; }

	.film__shade {
		position: absolute;
		inset: 0;
		background-color: rgb(0 0 0 / 15%);
		pointer-events: none;
		transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.film__play {
		position: absolute;
		top: 50%;
		left: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 6rem;
		height: 4rem;
		translate: -50% -50%;
		border-radius: 2px;
		background-color: #f4f0e8;
		color: #16100b;
		cursor: pointer;
		transition-duration: 0.3s;
		transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
		transition-property: background-color, opacity;
	}

	.film__play:focus-visible { outline: 2px solid #f4f0e8; outline-offset: 4px; }
	.film__play--hidden { opacity: 0; pointer-events: none; }
	.film__shade--hidden { opacity: 0; }
	.film__icon { width: 13px; height: 17px; fill: currentColor; }

	@media (hover: hover) {
		.film__play:hover { background-color: #e7c681; }
	}

	@media (min-width: 768px) {
		.film__header :global(.film__pattern) { margin-bottom: 2.25rem; }
		.film__player { aspect-ratio: 16 / 9; }
		.film__play { width: 120px; height: 5rem; }
	}
</style>

<script>
	document.querySelectorAll('[data-video-player]').forEach((player) => {
		const video = player.querySelector('[data-video-element]');
		const button = player.querySelector('[data-video-button]');
		const shade = player.querySelector('[data-video-shade]');

		if (!(video instanceof HTMLVideoElement) || !(button instanceof HTMLButtonElement)) return;
		video.controls = false;
		button.hidden = false;

		const showButton = () => {
			button.tabIndex = 0;
			button.classList.remove('film__play--hidden');
			shade?.classList.remove('film__shade--hidden');
		};

		const hideButton = () => {
			button.classList.add('film__play--hidden');
			shade?.classList.add('film__shade--hidden');
		};

		button.addEventListener('click', () => {
			video.controls = true;
			void video.play().catch(showButton);
		});
		video.addEventListener('play', () => {
			hideButton();
			button.tabIndex = -1;
		});
		video.addEventListener('pause', showButton);
		video.addEventListener('ended', showButton);
		video.addEventListener('error', () => {
			video.controls = true;
			showButton();
		});
	});
</script>
