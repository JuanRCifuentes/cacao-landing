---
import { getEntry } from 'astro:content';

const section = await getEntry('landingSections', 'partnerships-news');

if (!section || section.data.type !== 'partnershipsNews') {
	throw new Error('Missing landing section content: partnerships-news');
}

const { heading, cta, articles } = section.data;
---

<section id="partnerships-news" aria-labelledby="partnerships-news-heading" class="bg-white py-24 text-[#17140f] lg:py-40">
	<div class="mx-auto w-full max-w-[1440px]">
		<h2 id="partnerships-news-heading" class="px-4 text-xl tracking-[-0.02em] sm:px-8 lg:px-10 xl:px-16" data-motion="rise">{heading}</h2>

		<div class="mt-10 snap-x snap-mandatory scroll-px-4 overflow-x-auto pb-4 [scrollbar-width:none] sm:scroll-px-8 md:overflow-visible [&::-webkit-scrollbar]:hidden">
			<div class="flex w-max gap-4 px-4 sm:px-8 md:grid md:w-auto md:grid-cols-3 lg:gap-6 lg:px-10 xl:px-16">
				{articles.map((article) => (
				<article class="w-[85vw] max-w-[460px] shrink-0 snap-start md:w-auto md:max-w-none" data-motion="card">
					<a href={article.href} class="group flex h-full flex-col gap-6">
						<div class="aspect-[3/4] overflow-hidden rounded-[2px] bg-black/5">
							<img src={article.image.src} alt={article.image.alt} loading="lazy" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]" />
						</div>
						<div class="flex flex-col gap-2">
							<div class="flex items-center gap-2 text-sm uppercase tracking-[0.06em]">
								<time class="normal-case tracking-normal text-black/45">{article.date}</time>
								<span>{article.category}</span>
							</div>
							<h3 class="text-xl leading-[1.35] tracking-[-0.02em]">{article.heading}</h3>
							<p class="line-clamp-2 text-sm leading-[1.6] text-black/50">{article.excerpt}</p>
						</div>
					</a>
				</article>
				))}
			</div>
		</div>

		<div class="mt-[60px] flex justify-center px-4">
			<a href={cta.href} class="inline-flex h-9 min-w-[220px] items-center justify-center rounded-[2px] bg-black px-5 text-sm font-medium uppercase tracking-[0.06em] text-white transition-colors hover:bg-black/85">
				{cta.label}
			</a>
		</div>
	</div>
</section>
