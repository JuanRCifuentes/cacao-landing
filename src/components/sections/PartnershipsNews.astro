---
import { getLandingSection } from '../../lib/content';
import { getFeaturedStories } from '../../lib/stories';

const { heading, cta } = await getLandingSection('partnerships-news', 'partnershipsNews');
const articles = await getFeaturedStories();
---

<section id="partnerships-news" aria-labelledby="partnerships-news-heading" class="news">
	<div class="news__inner">
		<h2 id="partnerships-news-heading" class="news__heading" data-motion="rise">{heading}</h2>

		<div class="news__rail" data-motion-group>
			<div class="news__list">
				{articles.map((article, index) => (
				<article class="news__card" data-motion="card" style={`--motion-delay: ${Math.min(index, 2) * 70}ms`}>
					<a href={article.href} class="news__link">
						<div class="news__media">
							<img
								src={article.image.src}
								alt={article.image.alt}
								width={article.image.width}
								height={article.image.height}
								loading="lazy"
								decoding="async"
							/>
						</div>
						<div class="news__body">
							<div class="news__meta">
								<time datetime={article.dateIso}>{article.date}</time>
								<span>{article.category}</span>
							</div>
							<h3>{article.heading}</h3>
							<p class="news__excerpt">{article.excerpt}</p>
						</div>
					</a>
				</article>
				))}
			</div>
		</div>

		<div class="news__actions">
			<a href={cta.href} class="news__cta">
				{cta.label}
			</a>
		</div>
	</div>
</section>

<style>
	.news { padding-block: 6rem; background: #fff; color: #17140f; }
	.news__inner { width: 100%; max-width: 1440px; margin-inline: auto; }
	.news__heading { padding-inline: 1rem; font-size: 1.25rem; line-height: calc(1.75 / 1.25); letter-spacing: -.02em; }
	.news__rail { margin-top: 2.5rem; padding-bottom: 1rem; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: 1rem; scrollbar-width: none; }
	.news__rail::-webkit-scrollbar { display: none; }
	.news__list { display: flex; gap: 1rem; width: max-content; padding-inline: 1rem; }
	.news__card { flex-shrink: 0; width: 85vw; max-width: 460px; scroll-snap-align: start; }
	.news__link { display: flex; flex-direction: column; gap: 1.5rem; height: 100%; }
	.news__media { aspect-ratio: 3 / 4; overflow: hidden; border-radius: 2px; background: rgb(0 0 0 / 5%); }
	.news__media img { width: 100%; height: 100%; object-fit: cover; transition: scale .7s cubic-bezier(.4, 0, .2, 1); }
	.news__body { display: flex; flex-direction: column; gap: .5rem; }
	.news__meta { display: flex; align-items: center; gap: .5rem; font-size: .875rem; line-height: 1.25rem; letter-spacing: .06em; text-transform: uppercase; }
	.news__meta time { color: rgb(0 0 0 / 45%); letter-spacing: 0em; text-transform: none; }
	.news h3 { font-size: 1.25rem; line-height: 1.35; letter-spacing: -.02em; }
	.news__excerpt { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; font-size: .875rem; line-height: 1.6; color: rgb(0 0 0 / 50%); }
	.news__actions { display: flex; justify-content: center; margin-top: 60px; padding-inline: 1rem; }
	.news__cta { display: inline-flex; align-items: center; justify-content: center; min-width: 220px; height: 2.25rem; padding-inline: 1.25rem; border-radius: 2px; background: #000; color: #fff; font-size: .875rem; line-height: 1.25rem; font-weight: 500; letter-spacing: .06em; text-transform: uppercase; transition: background-color .15s cubic-bezier(.4, 0, .2, 1); }

	@media (hover: hover) {
		.news__link:hover img { scale: 1.03; }
		.news__cta:hover { background: rgb(0 0 0 / 85%); }
	}

	@media (min-width: 40rem) {
		.news__heading, .news__list { padding-inline: 2rem; }
		.news__rail { scroll-padding-inline: 2rem; }
	}

	@media (min-width: 48rem) {
		.news__rail { overflow: visible; }
		.news__list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); width: auto; }
		.news__card { width: auto; max-width: none; }
	}

	@media (min-width: 64rem) {
		.news { padding-block: 10rem; }
		.news__heading, .news__list { padding-inline: 2.5rem; }
		.news__list { gap: 1.5rem; }
	}

	@media (min-width: 80rem) {
		.news__heading, .news__list { padding-inline: 4rem; }
	}
</style>
