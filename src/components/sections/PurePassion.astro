---
import { getEntry } from 'astro:content';

const section = await getEntry('landingSections', 'pure-passion');

if (!section || section.data.type !== 'purePassion') {
	throw new Error('Missing landing section content: pure-passion');
}

const { eyebrow, heading, description, images } = section.data;
---

<section
	id="pure-passion"
	aria-labelledby="pure-passion-heading"
	class="overflow-hidden bg-[#f7f5f0] px-4 py-24 text-[#17140f] sm:px-8 lg:px-10 lg:py-40 xl:px-16"
>
	<div class="mx-auto w-full max-w-[1440px]">
		<header class="mx-auto flex max-w-[620px] flex-col items-center text-center lg:mx-0 lg:ml-[8.333%] lg:w-1/3 lg:items-start lg:text-left" data-motion="rise">
			<p class="text-xs font-medium uppercase leading-none tracking-[0.12em]">{eyebrow}</p>
			<h2
				id="pure-passion-heading"
				class="mt-3 text-[44px] font-medium uppercase leading-[0.88] tracking-[0.04em] sm:text-[56px]"
			>
				{heading}
			</h2>
			<p class="mt-8 text-sm leading-[1.65] tracking-[-0.01em] text-black/70">{description}</p>
		</header>

		<div class="mt-16 flex flex-col gap-16 lg:hidden">
			{images.map((image) => (
				<figure class="mx-auto flex w-full max-w-[540px] flex-col" data-motion="image">
					<div class="aspect-[3/4] overflow-hidden rounded-[2px] bg-black/5">
						<img src={image.src} alt={image.alt} loading="lazy" class="h-full w-full object-cover transition-transform duration-700 hover:scale-[1.02]" />
					</div>
					<figcaption class="mt-3 text-xs leading-[1.6] text-black/50">{image.caption}</figcaption>
				</figure>
			))}
		</div>

		<div class="relative mt-10 hidden h-[1500px] lg:block xl:h-[1650px]">
			<figure class="absolute top-0 left-[58.333%] w-1/4" data-motion="image">
				<div class="aspect-[161/215] overflow-hidden rounded-[2px] bg-black/5">
					<img src={images[0].src} alt={images[0].alt} loading="lazy" class="h-full w-full object-cover transition-transform duration-700 hover:scale-[1.02]" />
				</div>
				<figcaption class="mt-3 text-xs leading-[1.6] text-black/50">{images[0].caption}</figcaption>
			</figure>

			<figure class="absolute top-[360px] left-[8.333%] w-1/3 xl:top-[390px]" data-motion="image">
				<div class="aspect-[147/179] overflow-hidden rounded-[2px] bg-black/5">
					<img src={images[1].src} alt={images[1].alt} loading="lazy" class="h-full w-full object-cover transition-transform duration-700 hover:scale-[1.02]" />
				</div>
				<figcaption class="mt-3 text-xs leading-[1.6] text-black/50">{images[1].caption}</figcaption>
			</figure>

			<figure class="absolute top-[760px] right-[4.166%] w-[41.666%] xl:top-[790px]" data-motion="image">
				<div class="aspect-[551/735] overflow-hidden rounded-[2px] bg-black/5">
					<img src={images[2].src} alt={images[2].alt} loading="lazy" class="h-full w-full object-cover transition-transform duration-700 hover:scale-[1.02]" />
				</div>
				<figcaption class="mt-3 text-xs leading-[1.6] text-black/50">{images[2].caption}</figcaption>
			</figure>
		</div>
	</div>
</section>
