---
import { getLandingSection } from '../../lib/content';

const { eyebrow, heading, description, images } = await getLandingSection('pure-passion', 'purePassion');
---

<section
	id="pure-passion"
	aria-labelledby="pure-passion-heading"
	class="overflow-hidden bg-[#f7f5f0] px-4 py-24 text-[#17140f] sm:px-8 lg:px-10 lg:py-40 xl:px-16"
>
	<div class="mx-auto w-full max-w-[1440px]">
		<header class="mx-auto flex max-w-[620px] flex-col items-center text-center lg:mx-0 lg:ml-[8.333%] lg:w-1/3 lg:items-start lg:text-left" data-motion="rise">
			<p class="text-xs font-medium uppercase leading-none tracking-[0.12em]">{eyebrow}</p>
			<h2
				id="pure-passion-heading"
				class="mt-3 text-[44px] font-medium uppercase leading-[0.88] tracking-[0.04em] sm:text-[56px]"
			>
				{heading}
			</h2>
			<p class="mt-8 text-sm leading-[1.65] tracking-[-0.01em] text-black/70">{description}</p>
		</header>

		<div class="passion__gallery mt-16 flex flex-col gap-16 lg:relative lg:mt-10 lg:block lg:h-[1500px] xl:h-[1650px]">
			{images.map((image) => (
				<figure class="passion__figure mx-auto flex w-full max-w-[540px] flex-col lg:absolute lg:mx-0 lg:max-w-none" data-motion="image">
					<div class="passion__frame aspect-[3/4] overflow-hidden rounded-[2px] bg-black/5">
						<img
							src={image.src}
							alt={image.alt}
							loading="lazy"
							decoding="async"
							class="h-full w-full object-cover transition-transform duration-700 hover:scale-[1.02]"
						/>
					</div>
					<figcaption class="mt-3 text-xs leading-[1.6] text-black/50">{image.caption}</figcaption>
				</figure>
			))}
		</div>
	</div>
</section>

<style>
	@media (min-width: 1024px) {
		.passion__figure:nth-child(1) { top: 0; left: 58.333%; width: 25%; }
		.passion__figure:nth-child(1) .passion__frame { aspect-ratio: 161 / 215; }
		.passion__figure:nth-child(2) { top: 360px; left: 8.333%; width: 33.333%; }
		.passion__figure:nth-child(2) .passion__frame { aspect-ratio: 147 / 179; }
		.passion__figure:nth-child(3) { top: 760px; right: 4.166%; width: 41.666%; }
		.passion__figure:nth-child(3) .passion__frame { aspect-ratio: 551 / 735; }
	}

	@media (min-width: 1280px) {
		.passion__figure:nth-child(2) { top: 390px; }
		.passion__figure:nth-child(3) { top: 790px; }
	}
</style>
