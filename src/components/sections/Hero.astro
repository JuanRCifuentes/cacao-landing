---
import { getEntry } from 'astro:content';
import { getLandingSection } from '../../lib/content';

const { eyebrow, cta, scrollLabel, scrollHref, image } = await getLandingSection('hero', 'hero');
const footer = await getEntry('footer', 'main');

if (!footer) {
	throw new Error('Missing brand content');
}

const { brand, tagline } = footer.data;
---

<section id="hero" class="hero" aria-labelledby="hero-heading">
	<div class="hero__media">
		<img
			src={image.src}
			srcset={`${image.smallSrc} 960w, ${image.src} ${image.width}w`}
			sizes="100vw"
			width={image.width}
			height={image.height}
			alt={image.alt}
			fetchpriority="high"
			loading="eager"
			decoding="async"
		/>
	</div>
	<div class="hero__shade" aria-hidden="true"></div>

	<div class="hero__content">
		<p class="hero__eyebrow text-balance">{eyebrow}</p>
		<h1 id="hero-heading" class="hero__heading">
			<span data-hero-wordmark>{brand}</span>
		</h1>
		<p class="hero__tagline">{tagline}</p>
		<a class="hero__cta" href={cta.href}>
			<span>{cta.label}</span>
			<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<path d="M4 12h15m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.25" />
			</svg>
		</a>
	</div>

	<a href={scrollHref} class="hero__scroll">
		<span>{scrollLabel}</span>
		<svg viewBox="0 0 16 24" fill="none" aria-hidden="true">
			<path d="M8 2v19m-5-5 5 5 5-5" stroke="currentColor" />
		</svg>
	</a>
</section>

<style>
	.hero {
		--hero-tail: clamp(64px, 10vh, 112px);
		position: relative;
		isolation: isolate;
		display: grid;
		place-items: center;
		min-height: calc(max(660px, 100vh) + var(--hero-tail));
		min-height: calc(max(660px, 100svh) + var(--hero-tail));
		padding: 160px 24px calc(120px + var(--hero-tail));
		background: #16100b;
		color: #f4f0e8;
	}

	@supports (height: 100svh) {
		.hero { --hero-tail: clamp(64px, 10svh, 112px); }
	}

	.hero__media,
	.hero__shade {
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;
	}

	.hero__media {
		bottom: var(--hero-tail);
		overflow: hidden;
	}

	.hero__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 55% center;
		animation: hero-image-arrive 2.2s cubic-bezier(0.22, 1, 0.36, 1) backwards;
	}

	.hero__shade {
		/* Match Safari's theme color at the edge, then blend into the warm image tint. */
		background:
			linear-gradient(180deg, #16100b 32px, rgb(26 17 12 / 55%) 160px, rgb(26 17 12 / 36%) 30%, rgb(26 17 12 / 44%) 60%, #16100b calc(100% - var(--hero-tail)), #16100b),
			rgb(61 34 17 / 28%);
	}

	.hero__content { width: 100%; max-width: 1040px; text-align: center; color: #ead6ae; }

	.hero__eyebrow {
		margin-bottom: 24px;
		font-size: 12px;
		font-weight: 700;
		line-height: 1.4;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		text-shadow: 0 1px 3px rgb(22 16 11 / 90%), 0 2px 14px rgb(22 16 11 / 65%);
		animation: hero-fade 0.9s ease-out 0.15s backwards;
	}

	.hero__heading {
		font-family: 'Abril Fatface', Georgia, serif;
		font-size: clamp(2rem, 10.6vw, 7.25rem);
		font-weight: 400;
		line-height: 1.12;
		letter-spacing: -0.035em;
		-webkit-text-stroke: 0.006em currentColor;
		text-shadow: 0 0.04em 0.4em rgb(0 0 0 / 40%);
	}

	.hero__heading > span { display: inline-block; white-space: nowrap; }
	.hero__tagline {
		max-width: 26ch;
		margin: 18px auto 0;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: clamp(18px, 1.7vw, 22px);
		font-style: italic;
		font-weight: 400;
		line-height: 1.5;
		letter-spacing: 0.01em;
		text-wrap: balance;
		color: #e5d6bd;
		text-shadow: 0 1px 8px rgb(22 16 11 / 75%);
		animation: hero-fade 0.9s ease-out 0.4s backwards;
	}

	@media (min-width: 768px) {
		.hero__tagline { max-width: none; margin-top: 20px; }
	}

	.hero__cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 18px;
		min-height: 44px;
		margin-top: 38px;
		padding: 12px 18px;
		border: 1px solid rgb(234 214 174 / 55%);
		border-radius: 2px;
		background: rgb(22 16 11 / 24%);
		color: #ead6ae;
		font-size: 11px;
		font-weight: 600;
		line-height: 1.4;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		transition: background-color 200ms, border-color 200ms;
		animation: hero-fade 0.9s ease-out 0.65s backwards;
	}

	.hero__cta:hover { background: rgb(234 214 174 / 12%); border-color: #ead6ae; }
	.hero__cta svg { width: 18px; height: 18px; }
	.hero a:focus-visible { outline: 2px solid currentColor; outline-offset: 6px; }
	.hero__cta:focus-visible { outline-color: #f4f0e8; }

	.hero__scroll {
		position: absolute;
		bottom: calc(28px + var(--hero-tail));
		left: 50%;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12px;
		padding: 8px 16px;
		font-size: 9px;
		line-height: 1.4;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		transform: translateX(-50%);
	}

	.hero__scroll svg { width: 14px; height: 22px; }

	@keyframes hero-image-arrive {
		from { opacity: 0; transform: scale(1.055); }
		to { opacity: 1; transform: scale(1); }
	}
	@keyframes hero-fade { from { opacity: 0; } to { opacity: 1; } }

	@media (max-width: 600px) {
		.hero { padding: 150px 24px calc(115px + var(--hero-tail)); }
		.hero__media img {
			position: relative;
			top: 32px;
			-webkit-mask-image: linear-gradient(to bottom, transparent, #000 32px);
			mask-image: linear-gradient(to bottom, transparent, #000 32px);
		}
		.hero__eyebrow { margin-bottom: 22px; font-size: 11px; }
		.hero__cta { margin-top: 32px; }
		.hero__scroll { bottom: calc(20px + var(--hero-tail)); }
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__media img,
		.hero__eyebrow,
		.hero__tagline,
		.hero__cta { animation: none; transition: none; }
	}
</style>
