---
import { getEntry } from 'astro:content';
import CocoaLogo from '../CocoaLogo.astro';
import HeroMenu from '../HeroMenu.astro';

const section = await getEntry('landingSections', 'hero');
const footer = await getEntry('footer', 'main');

if (!section || section.data.type !== 'hero' || !footer) {
	throw new Error('Missing hero or brand content');
}

const { eyebrow, heading, cta, scrollLabel, contactLabel, navigation, image } = section.data;
const { brand, tagline, contact } = footer.data;
---

<section id="hero" class="hero" aria-labelledby="hero-heading">
	<div class="hero__media">
		<img
			src={image.src}
			srcset={`${image.smallSrc} 960w, ${image.src} ${image.width}w`}
			sizes="100vw"
			width={image.width}
			height={image.height}
			alt={image.alt}
			fetchpriority="high"
			loading="eager"
		/>
	</div>
	<div class="hero__shade" aria-hidden="true"></div>

	<header class="hero__header">
		<HeroMenu navigation={navigation} brand={brand} tagline={tagline} contactEmail={contact.email} />
		<a class="hero__brand" href="#hero" aria-label={`${brand}, home`}>
			<CocoaLogo animated brand={brand} showTagline={false} class="w-full" />
		</a>
		<a class="hero__contact" href="#newsletter">
			<span>{contactLabel}</span>
			<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.25" />
			</svg>
		</a>
	</header>

	<div class="hero__content">
		<p class="hero__eyebrow">{eyebrow}</p>
		<h1 id="hero-heading" class="hero__heading" aria-label={heading.join(' ')}>
			{heading.map((line, index) => (
				<span class="hero__line"><span style={`--line-delay: ${0.25 + index * 0.12}s`}>{line}</span></span>
			))}
		</h1>
		<a class="hero__cta" href={cta.href}>
			<span>{cta.label}</span>
			<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<path d="M4 12h15m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.25" />
			</svg>
		</a>
	</div>

	<a href={cta.href} class="hero__scroll">
		<span>{scrollLabel}</span>
		<svg viewBox="0 0 16 24" fill="none" aria-hidden="true">
			<path d="M8 2v19m-5-5 5 5 5-5" stroke="currentColor" />
		</svg>
	</a>
</section>

<style>
	.hero {
		position: relative;
		isolation: isolate;
		display: grid;
		place-items: center;
		min-height: max(660px, 100svh);
		padding: 160px 24px 120px;
		background: #261c17;
		color: #f4f0e8;
	}

	.hero__media,
	.hero__shade {
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;
	}

	.hero__media { overflow: hidden; }

	.hero__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 55% center;
		animation: hero-image-arrive 2.2s cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.hero__shade {
		background: linear-gradient(180deg, rgb(26 17 12 / 55%), rgb(26 17 12 / 20%) 30%, rgb(26 17 12 / 32%) 60%, rgb(26 17 12 / 72%));
	}

	.hero__header {
		position: absolute;
		z-index: 2;
		top: 0;
		left: 50%;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		width: 100%;
		max-width: 1536px;
		padding: 24px clamp(24px, 4vw, 64px);
		transform: translateX(-50%);
	}

	.hero__brand { display: block; width: 150px; }

	.hero__contact {
		display: inline-flex;
		align-items: center;
		justify-self: end;
		gap: 12px;
		min-height: 44px;
		font-size: 11px;
		line-height: 1.3;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.hero__contact svg { width: 18px; height: 18px; }
	.hero__content { text-align: center; }

	.hero__eyebrow {
		margin-bottom: 24px;
		font-size: 11px;
		font-weight: 500;
		line-height: 1.4;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		animation: hero-fade 0.9s ease-out 0.15s both;
	}

	.hero__heading {
		font-family: 'Abril Fatface', Georgia, serif;
		font-size: clamp(3.3rem, 7.1vw, 7.25rem);
		font-weight: 400;
		line-height: 1.04;
		letter-spacing: -0.035em;
	}

	.hero__line { display: block; overflow: hidden; padding: 0 0.08em 0.08em; margin-bottom: -0.08em; }
	.hero__line > span {
		display: block;
		animation: hero-type-arrive 1.1s cubic-bezier(0.22, 1, 0.36, 1) var(--line-delay) both;
	}

	.hero__cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 24px;
		min-height: 44px;
		min-width: 230px;
		margin-top: 38px;
		padding: 12px 22px;
		border: 1px solid #f4f0e8;
		border-radius: 2px;
		background: #f4f0e8;
		color: #261c17;
		font-size: 11px;
		font-weight: 500;
		line-height: 1.4;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		transition: background-color 200ms, border-color 200ms;
		animation: hero-fade 0.9s ease-out 0.65s both;
	}

	.hero__cta:hover { background: #e7c681; border-color: #e7c681; }
	.hero__cta svg { width: 18px; height: 18px; }
	.hero a:focus-visible { outline: 2px solid currentColor; outline-offset: 6px; }
	.hero__cta:focus-visible { outline-color: #f4f0e8; }

	.hero__scroll {
		position: absolute;
		bottom: 28px;
		left: 50%;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12px;
		padding: 8px 16px;
		font-size: 9px;
		line-height: 1.4;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		transform: translateX(-50%);
	}

	.hero__scroll svg { width: 14px; height: 22px; }

	@keyframes hero-image-arrive {
		from { opacity: 0; transform: scale(1.055); }
		to { opacity: 1; transform: scale(1); }
	}
	@keyframes hero-type-arrive {
		from { transform: translateY(110%); }
		to { transform: translateY(0); }
	}
	@keyframes hero-fade { from { opacity: 0; } to { opacity: 1; } }

	@media (max-width: 600px) {
		.hero { padding: 150px 24px 115px; }
		.hero__header { padding: 20px 24px; }
		.hero__brand { width: 128px; }
		.hero__contact span {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip-path: inset(50%);
			white-space: nowrap;
		}
		.hero__contact { justify-content: center; width: 44px; }
		.hero__eyebrow { margin-bottom: 22px; font-size: 10px; }
		.hero__cta { margin-top: 32px; width: 100%; min-width: 0; }
		.hero__scroll { bottom: 20px; }
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__media img,
		.hero__eyebrow,
		.hero__line > span,
		.hero__cta { animation: none; transition: none; }
	}
</style>
