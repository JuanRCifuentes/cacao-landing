---
import { getEntry } from 'astro:content';

const heritage = await getEntry('landingSections', 'heritage');

if (!heritage) {
	throw new Error('Missing landing section content: heritage');
}

const { eyebrow, heading, description, cta, images } = heritage.data;
---

<section
	id="heritage"
	aria-labelledby="heritage-heading"
	class="relative isolate h-svh min-h-[700px] overflow-hidden bg-white text-black lg:min-h-[900px]"
>
	<div class="absolute inset-0 flex justify-center lg:items-center" aria-hidden="true">
		<div class="relative h-full w-full max-w-[1440px] lg:max-h-[900px]">
			<div class="absolute top-[4%] left-1/2 z-30 hidden aspect-video w-[min(42%,640px)] -translate-x-1/2 overflow-hidden lg:block">
				<img src={images.team} alt="" class="h-full w-full object-cover" />
			</div>

			<div class="absolute top-[38%] left-[-5%] z-20 hidden aspect-video w-[min(22%,320px)] overflow-hidden lg:block">
				<img src={images.coffee} alt="" loading="lazy" class="h-full w-full object-cover" />
			</div>

			<div class="absolute top-[10%] left-[8%] z-10 hidden aspect-3/2 w-[min(16%,220px)] overflow-hidden opacity-30 lg:block">
				<img src={images.roastery} alt="" loading="lazy" class="h-full w-full object-cover" />
			</div>

			<div class="absolute top-[12%] left-[85%] z-10 hidden aspect-3/2 w-[min(22%,430px)] overflow-hidden opacity-30 lg:block">
				<img src={images.beans} alt="" loading="lazy" class="h-full w-full object-cover" />
			</div>

			<div class="absolute top-[48%] left-[75%] z-10 hidden aspect-3/2 w-[min(14%,200px)] overflow-hidden opacity-30 lg:block">
				<img src={images.barista} alt="" loading="lazy" class="h-full w-full object-cover" />
			</div>

			<div class="absolute top-[75%] left-[18%] z-10 hidden aspect-3/2 w-[min(15%,210px)] overflow-hidden opacity-35 lg:block">
				<img src={images.harvest} alt="" loading="lazy" class="h-full w-full object-cover" />
			</div>

			<div class="absolute top-[70%] left-[82%] z-20 hidden aspect-8/5 w-[min(32%,300px)] overflow-hidden lg:block">
				<img src={images.cup} alt="" loading="lazy" class="h-full w-full object-cover" />
			</div>

			<div class="absolute top-[2%] left-[-18%] z-10 aspect-4/3 w-[42vw] overflow-hidden opacity-[0.14] lg:hidden">
				<img src={images.coffee} alt="" loading="lazy" class="h-full w-full object-cover" />
			</div>

			<div class="absolute top-[6%] left-[78%] z-10 aspect-3/2 w-[40vw] overflow-hidden opacity-[0.16] lg:hidden">
				<img src={images.roastery} alt="" loading="lazy" class="h-full w-full object-cover" />
			</div>

			<div class="absolute top-[68%] left-[-12%] z-10 aspect-4/3 w-[38vw] overflow-hidden opacity-[0.14] lg:hidden">
				<img src={images.beans} alt="" loading="lazy" class="h-full w-full object-cover" />
			</div>

			<div class="absolute top-[72%] left-[62%] z-10 aspect-4/3 w-[52vw] overflow-hidden opacity-20 lg:hidden">
				<img src={images.barista} alt="" loading="lazy" class="h-full w-full object-cover" />
			</div>
		</div>
	</div>

	<div class="relative z-10 flex h-full flex-col items-center justify-center px-4 py-10 lg:justify-end lg:pb-48 lg:pt-0">
		<div class="flex w-full max-w-[438px] flex-col items-center gap-8 text-center">
			<div class="relative aspect-16/10 w-[78vw] max-w-[320px] overflow-hidden lg:hidden" aria-hidden="true">
				<img src={images.team} alt="" class="h-full w-full object-cover" />
			</div>

			<p class="-mb-4 text-xs font-medium uppercase leading-none tracking-[0.72px]">{eyebrow}</p>
			<h2
				id="heritage-heading"
				class="w-full text-[40px] font-medium uppercase leading-[0.85] tracking-[2.24px] lg:text-[56px]"
			>
				{heading}
			</h2>
			<p class="w-full text-sm leading-[1.6] tracking-[-0.14px] text-black/80">
				{description}
			</p>
			<a
				href={cta.href}
				class="inline-flex h-9 min-w-[220px] items-center justify-center rounded-[2px] bg-black px-4 text-sm font-medium uppercase tracking-[0.84px] text-white transition-colors hover:bg-black/90 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-black"
			>
				{cta.label}
			</a>
		</div>
	</div>
</section>
