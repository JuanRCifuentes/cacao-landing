---
import { getEntry } from 'astro:content';
import { getLandingSection } from '../../lib/content';

const footer = await getEntry('footer', 'main');
if (!footer) throw new Error('Missing footer contact content');
const requestHref = `mailto:${footer.data.contact.email}?subject=${encodeURIComponent('Quiero recibir novedades de Origen Tolima')}`;
const { heading, description, background } = await getLandingSection('newsletter', 'newsletter');
---

<section id="newsletter" aria-labelledby="newsletter-heading" class="relative isolate flex min-h-svh items-center overflow-hidden py-24 text-white md:min-h-[120vh] md:py-36">
	<div class="absolute inset-0 -z-20">
		<img src={background.src} alt={background.alt} loading="lazy" decoding="async" class="h-full w-full object-cover object-center" />
	</div>
	<div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(0,0,0,0.78)_0%,rgba(0,0,0,0.46)_52%,rgba(0,0,0,0.28)_100%)] md:bg-[linear-gradient(270deg,rgba(0,0,0,0.35)_0%,rgba(0,0,0,0.1)_48%,rgba(0,0,0,0.68)_100%)]"></div>

	<div class="mx-auto w-full max-w-[1440px] px-4 sm:px-8 md:px-[77px]">
		<div class="w-full max-w-[400px]">
			<div class="flex flex-col gap-10 md:gap-14">
				<h2 id="newsletter-heading" class="text-[38px] leading-[1.1] tracking-[-0.03em]" data-motion="rise">{heading}</h2>
				<p class="text-sm leading-[1.6] text-white/85">{description}</p>

				<div class="flex flex-col gap-4">
					<a href={requestHref} class="inline-flex min-h-11 w-fit items-center border-b border-white/60 py-2 text-xs uppercase tracking-[0.08em] hover:opacity-75 focus-visible:outline-2 focus-visible:outline-offset-4">Solicitar novedades por correo <span aria-hidden="true" class="ml-4">↗</span></a>
					<p class="text-xs leading-relaxed text-white/75">Se abrirá tu aplicación de correo para enviar una solicitud. No te suscribimos automáticamente. Consulta nuestra <a href="/privacidad/" class="underline underline-offset-4">política de privacidad</a>.</p>
				</div>
			</div>
		</div>
	</div>
</section>
