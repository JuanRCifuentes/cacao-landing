---
import { getEntry } from 'astro:content';
import { getLandingSection } from '../../lib/content';

const footer = await getEntry('footer', 'main');
if (!footer) throw new Error('Missing footer contact content');
const requestHref = `mailto:${footer.data.contact.email}?subject=${encodeURIComponent('Quiero recibir novedades de Origen Tolima')}`;
const { heading, description, background } = await getLandingSection('newsletter', 'newsletter');
---

<section id="newsletter" aria-labelledby="newsletter-heading" class="newsletter">
	<div class="newsletter__media">
		<img src={background.src} alt={background.alt} loading="lazy" decoding="async" class="newsletter__image" />
	</div>
	<div class="newsletter__shade"></div>

	<div class="newsletter__inner">
		<div class="newsletter__content">
			<div class="newsletter__stack">
				<h2 id="newsletter-heading" class="newsletter__heading" data-motion="rise">{heading}</h2>
				<p class="newsletter__description">{description}</p>

				<div class="newsletter__actions">
					<a href={requestHref} class="newsletter__link">Solicitar novedades por correo <span aria-hidden="true" class="newsletter__arrow">↗</span></a>
					<p class="newsletter__note">Se abrirá tu aplicación de correo para enviar una solicitud. No te suscribimos automáticamente. Consulta nuestra <a href="/privacidad/" class="newsletter__privacy">política de privacidad</a>.</p>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.newsletter {
		position: relative;
		isolation: isolate;
		display: flex;
		align-items: center;
		min-height: 100svh;
		overflow: hidden;
		padding-block: 6rem;
		color: #fff;
	}

	.newsletter__media { position: absolute; inset: 0; z-index: -20; }

	.newsletter__shade {
		position: absolute;
		inset: 0;
		z-index: -10;
		background-image: linear-gradient(90deg, rgb(0 0 0 / 78%) 0%, rgb(0 0 0 / 46%) 52%, rgb(0 0 0 / 28%) 100%);
	}

	.newsletter__image { width: 100%; height: 100%; object-fit: cover; object-position: center; }
	.newsletter__inner { width: 100%; max-width: 1440px; margin-inline: auto; padding-inline: 1rem; }
	.newsletter__content { width: 100%; max-width: 400px; }
	.newsletter__stack { display: flex; flex-direction: column; gap: 2.5rem; }
	.newsletter__heading { font-size: 38px; line-height: 1.1; letter-spacing: -0.03em; }
	.newsletter__description { color: rgb(255 255 255 / 85%); font-size: 0.875rem; line-height: 1.6; }
	.newsletter__actions { display: flex; flex-direction: column; gap: 1rem; }

	.newsletter__link {
		display: inline-flex;
		align-items: center;
		width: fit-content;
		min-height: 2.75rem;
		padding-block: 0.5rem;
		border-bottom: 1px solid;
		border-color: rgb(255 255 255 / 60%);
		font-size: 0.75rem;
		line-height: 1rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.newsletter__link:focus-visible { outline-style: solid; outline-width: 2px; outline-offset: 4px; }
	.newsletter__arrow { margin-left: 1rem; }
	.newsletter__note { color: rgb(255 255 255 / 75%); font-size: 0.75rem; line-height: 1.625; }
	.newsletter__privacy { text-decoration-line: underline; text-underline-offset: 4px; }

	@media (hover: hover) {
		.newsletter__link:hover { opacity: 0.75; }
	}

	@media (min-width: 640px) {
		.newsletter__inner { padding-inline: 2rem; }
	}

	@media (min-width: 768px) {
		.newsletter { min-height: 120vh; padding-block: 9rem; }
		.newsletter__shade { background-image: linear-gradient(270deg, rgb(0 0 0 / 35%) 0%, rgb(0 0 0 / 10%) 48%, rgb(0 0 0 / 68%) 100%); }
		.newsletter__inner { padding-inline: 77px; }
		.newsletter__stack { gap: 3.5rem; }
	}
</style>
