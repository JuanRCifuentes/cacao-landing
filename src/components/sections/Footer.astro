---
import { getEntry } from 'astro:content';
import CocoaLogo from '../CocoaLogo.astro';
import PackagingPattern from '../PackagingPattern.astro';

const footer = await getEntry('footer', 'main');

if (!footer) {
	throw new Error('Missing site content: footer');
}

const { brand, tagline, labels, navigation, policies, newsletter, socials, contact, trade, location, copyright } =
	footer.data;
---

<footer id="site-footer" class="relative z-30 bg-[#f4f0e8] pt-20 text-[#17140f] md:pt-40">
	<div class="mx-auto flex w-full max-w-[1440px] flex-col px-4 pt-10 lg:flex-row lg:gap-16 lg:px-10 lg:pt-20 lg:pb-10 xl:gap-28 xl:px-16">
		<a href="#hero" aria-label={`${brand}, ${labels.backToTop}`} class="group hidden shrink-0 lg:block lg:w-[220px] xl:w-[320px]">
			<span class="block w-full transition-transform duration-500 group-hover:-translate-y-1 motion-reduce:transform-none">
				<CocoaLogo animated brand={brand} tagline={tagline} class="h-auto w-full" />
			</span>
		</a>

		<div class="flex min-w-0 flex-1 flex-col justify-between gap-12 lg:pb-10">
			<div class="flex flex-col gap-12 lg:flex-row lg:justify-between lg:gap-10">
				<nav aria-label={labels.navigation} class="min-w-0 flex-1">
					<ul class="flex flex-col gap-2">
						{navigation.map((item) => (
							<li>
								<a
									href={item.href}
									class="group inline-flex items-baseline gap-3 text-[32px] leading-[1.12] tracking-[-0.04em] sm:text-[38px] xl:text-[44px]"
								>
									<span>{item.label}</span>
									<span class="h-px w-0 bg-current transition-[width] duration-300 group-hover:w-8" aria-hidden="true"></span>
								</a>
							</li>
						))}
					</ul>
				</nav>

				<div class="flex w-full flex-col gap-8 text-sm leading-[1.6] tracking-[-0.01em] lg:w-60 lg:shrink-0 lg:items-end lg:text-right">
					<div class="flex flex-col gap-1 lg:items-end">
						{policies.map((item) => (
							<a href={item.href} class="w-fit border-b border-transparent transition-colors hover:border-current">{item.label}</a>
						))}
					</div>
					<a href={newsletter.href} class="w-fit border-b border-current pb-0.5">{newsletter.label}</a>
				</div>
			</div>

			<nav aria-label={labels.socialMedia} class="flex flex-wrap gap-x-7 gap-y-3 text-xs font-medium uppercase tracking-[0.12em] lg:pt-14">
				{socials.map((item) => (
					<a href={item.href} class="transition-opacity hover:opacity-50">{item.label}</a>
				))}
			</nav>
		</div>
	</div>

	<div class="mx-auto mt-10 h-px w-full max-w-[1440px] bg-black/10 lg:mt-0"></div>

	<div class="mx-auto grid w-full max-w-[1440px] gap-6 px-4 py-10 text-xs leading-[1.6] tracking-[-0.01em] sm:grid-cols-2 lg:grid-cols-5 lg:px-10 xl:px-16">
		<div>
			<p>{contact.label}</p>
			<a href={contact.phone.href} class="border-b border-current pb-0.5">{contact.phone.label}</a>
		</div>
		<div>
			<a href={`mailto:${contact.email}`} class="border-b border-transparent transition-colors hover:border-current">{contact.email}</a>
		</div>
		<div>
			<p>{trade.label}</p>
			<a href={`mailto:${trade.email}`} class="border-b border-transparent transition-colors hover:border-current">{trade.email}</a>
		</div>
		<div>
			{location.map((line) => <p>{line}</p>)}
		</div>
		<div class="text-black/50 lg:text-right">
			<p>{copyright}</p>
		</div>
	</div>

	<div class="flex justify-center px-4 pb-10 lg:hidden">
		<a href="#hero" aria-label={`${brand}, ${labels.backToTop}`} class="block w-full max-w-[320px]">
			<CocoaLogo animated brand={brand} tagline={tagline} class="h-auto w-full" />
		</a>
	</div>
	<div class="border-t border-[#c6ab86]/15 bg-[#16100b] py-2 md:py-3">
		<PackagingPattern class="h-12 text-[#c6ab86]/45 md:h-16 md:[--pattern-size:480px]" />
	</div>
</footer>
