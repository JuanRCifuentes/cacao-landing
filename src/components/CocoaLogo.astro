---
import CacaoPod from '../../public/cocoa-mark.svg';

interface Props {
	class?: string;
	animated?: boolean;
	brand?: string;
	tagline?: string;
}

const {
	class: className,
	animated = false,
	brand = 'Origen Tolima',
	tagline = 'Cacao de autor un legado de bienestar',
} = Astro.props;
---

<span
	data-cocoa-logo-reveal={animated ? '' : undefined}
	class:list={['cocoa-logo', className]}
>
	<CacaoPod aria-hidden="true" focusable="false" class="cocoa-logo__mark" />
	<span class="cocoa-logo__wordmark">{brand}</span>
	<span class="cocoa-logo__tagline">{tagline}</span>
</span>

<style>
	@font-face {
		font-family: 'Abril Fatface';
		src: url('/fonts/abril-fatface-latin.woff2') format('woff2');
		font-style: normal;
		font-weight: 400;
		font-display: swap;
	}

	.cocoa-logo {
		display: flex;
		flex-direction: column;
		align-items: center;
		container-type: inline-size;
		overflow: visible;
	}

	.cocoa-logo :global(.cocoa-logo__mark) {
		display: block;
		width: 27%;
		height: auto;
		margin-bottom: 7cqw;
		/* A faint variation in ink density, with the original linework underneath. */
		-webkit-mask-image: url('/cocoa-ink-texture.svg');
		mask-image: url('/cocoa-ink-texture.svg');
		-webkit-mask-size: 64px 64px;
		mask-size: 64px 64px;
		-webkit-mask-repeat: repeat;
		mask-repeat: repeat;
		mask-mode: alpha;
	}

	.cocoa-logo__wordmark {
		font-family: 'Abril Fatface', Georgia, serif;
		font-size: 13.7cqw;
		font-weight: 400;
		line-height: 1.12;
		letter-spacing: -0.035em;
		white-space: nowrap;
	}

	.cocoa-logo__tagline {
		align-self: flex-end;
		margin-top: 0.5cqw;
		margin-right: 1cqw;
		font-size: max(7px, 2.3cqw);
		font-weight: 500;
		line-height: 1.4;
		letter-spacing: 0.015em;
		text-transform: uppercase;
		white-space: nowrap;
	}

	/* Only hide artwork once the observer is ready; the SVG also works without JS. */
	.cocoa-logo.is-pending {
		opacity: 0;
		transform: translateY(8px) scale(0.98);
		transform-origin: 50% 50%;
	}

	.cocoa-logo.is-visible {
		animation: cocoa-logo-arrive 1.4s cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.cocoa-logo.is-pending :global(.cocoa-logo__stroke) {
		stroke-dasharray: 1;
		stroke-dashoffset: 1;
	}

	.cocoa-logo.is-visible :global(.cocoa-logo__stroke) {
		animation: cocoa-logo-draw 1.1s cubic-bezier(0.65, 0, 0.35, 1) both;
		animation-delay: var(--draw-delay, 0.08s);
	}

	.cocoa-logo.is-visible :global(.cocoa-logo__shell) {
		animation-duration: 1.25s;
	}

	.cocoa-logo.is-pending :global(.cocoa-logo__wordmark),
	.cocoa-logo.is-pending :global(.cocoa-logo__tagline) {
		opacity: 0;
	}

	.cocoa-logo.is-visible :global(.cocoa-logo__wordmark),
	.cocoa-logo.is-visible :global(.cocoa-logo__tagline) {
		animation: cocoa-logo-lettering 0.9s ease-out both;
		animation-delay: 1.05s;
	}

	.cocoa-logo.is-visible :global(.cocoa-logo__tagline) {
		animation-delay: 1.4s;
	}

	@keyframes cocoa-logo-draw {
		from { stroke-dashoffset: 1; }
		to { stroke-dashoffset: 0; }
	}

	@keyframes cocoa-logo-arrive {
		0% { opacity: 0; transform: translateY(8px) scale(0.98); }
		35% { opacity: 1; }
		100% { opacity: 1; transform: translateY(0) scale(1); }
	}

	@keyframes cocoa-logo-lettering {
		from { opacity: 0; }
		to { opacity: 1; }
	}

	@media (prefers-reduced-motion: reduce) {
		.cocoa-logo.is-pending,
		.cocoa-logo.is-visible,
		.cocoa-logo.is-pending :global(.cocoa-logo__stroke),
		.cocoa-logo.is-visible :global(.cocoa-logo__stroke),
		.cocoa-logo.is-pending :global(.cocoa-logo__wordmark),
		.cocoa-logo.is-visible :global(.cocoa-logo__wordmark),
		.cocoa-logo.is-pending :global(.cocoa-logo__tagline),
		.cocoa-logo.is-visible :global(.cocoa-logo__tagline) {
			animation: none;
			opacity: 1;
			transform: none;
			stroke-dashoffset: 0;
		}
	}
</style>

<script>
	const logos = document.querySelectorAll<HTMLElement>('[data-cocoa-logo-reveal]');

	if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;

					entry.target.classList.add('is-visible');
					observer.unobserve(entry.target);
				}
			},
			{ threshold: 0.35 },
		);

		for (const logo of logos) {
			logo.classList.add('is-pending');
			observer.observe(logo);
		}
	}
</script>
